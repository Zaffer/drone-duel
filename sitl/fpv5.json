# A typical 5 inch freestyle quad, X frame, for ArduPilot SITL (SIM_Frame). Started from
# ArduPilot's Tools/autotest/models/freestyle.json; mass, size, thrust and disc area set to a
# typical build:
#   2207 1950 KV motors, 5.1 x 3.6 tri-blade props, 6S 1300 mAh, light action camera.
#   About 750 g all up, 225 mm motor to motor.
#   Each motor about 1.7 kgf (16.6 N) static at full throttle on a full pack: 6.8 kgf in all,
#   a thrust to weight ratio of 9.
# SITL takes thrust to weight as 1 / hoverThrOut: max thrust T(c) = T_max * ((1 - e) c + e c^2)
# for motor command c and propExpo e, with T_max = weight / hoverThrOut. Hover then needs about
# 24 % motor output, as a 5 inch shows in Betaflight.

{
    # all-up mass in kg: about 450 g dry, 210 g 6S 1300 mAh pack, 90 g action camera
    "mass" : 0.75,

    # motor to motor diagonal in metres (225 mm wheelbase)
    "diagonal_size" : 0.225,

    # drag: the speed it settles at with a 45 degree lean in still air
    "refSpd" : 22.0,     # m/s, about 80 km/h
    "refAngle" : 45.0,   # degrees
    "refVoltage" : 22.8, # volts, 6S under load
    "refCurrent" : 6,    # amps at hover, about 135 W for 750 g
    "refAlt" : 174,      # metres AMSL, the sim field
    "refTempC" : 25,     # degrees C
    "refBatRes" : 0.0226, # ohms, BAT.Res of a 6S pack

    # full 6S pack
    "maxVoltage" : 25.2,

    # pack capacity in Ah; 0 is unlimited, so a long rehearsal never runs flat.
    # A real 6S 1300 mAh lasts about 4 to 6 minutes of cruising.
    "battCapacityAh" : 0,

    # MOT_THST_EXPO
    "propExpo" : 0.7,

    # approximate maximum yaw rate in deg/s
    "refRotRate" : 700,

    # thrust to weight 9: 1 / 9
    "hoverThrOut" : 0.111,

    # MOT_PWM_MIN, MOT_PWM_MAX
    "pwmMin" : 1000,
    "pwmMax" : 2000,

    # MOT_SPIN_MIN, MOT_SPIN_MAX
    "spin_min" : 0.01,
    "spin_max" : 0.95,

    # maximum motor slew rate, or zero for none
    "slew_max" : 0,

    # total disc area of four 5.1 inch (0.13 m) props: 4 * pi * 0.065^2.
    # (freestyle.json has 0.204, which takes 5 inches as the radius.)
    "disc_area" : 0.053,

    # momentum drag coefficient, relative to a ducted rotor of the same disc area
    "mdrag_coef" : 0.10,

    "num_motors" : 4
}
