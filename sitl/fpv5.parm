# Airframe tune for the sim's 5 inch quad (sitl/fpv5.json), loaded after ArduPilot's
# copter.parm and before swarm.parm. Names are ArduCopter 4.7. Taken from ArduPilot's own
# freestyle model tune (Tools/autotest/models/freestyle.param): only what belongs to the
# airframe, its control loops and filters. Flight modes, speeds and the mission stay in
# swarm.parm.
#
# This stands in for each real drone's own tune. Do not load it onto real drones: tune them
# (autotune, Betaflight-style filtering) on the airframe itself.

# Quad X, matching the sim model's X motor layout.
FRAME_CLASS      1
FRAME_TYPE       1

# Motors: 6S, thrust curve and hover throttle of the model (MOT_THST_HOVER is learnt in flight).
MOT_BAT_VOLT_MAX 25.2
MOT_BAT_VOLT_MIN 19.8
MOT_SPIN_ARM     0.01
MOT_SPIN_MIN     0.01
MOT_SPOOL_TIME   0.25
MOT_THST_EXPO    0.7
MOT_THST_HOVER   0.11
BATT_CAPACITY    1300

# Lean and attitude limits of a 5 inch.
ATC_ANGLE_MAX    70
ATC_ACC_P_MAX    1600
ATC_ACC_R_MAX    1600
ATC_ACC_Y_MAX    1200
ATC_ANG_PIT_P    15
ATC_ANG_RLL_P    15
ATC_ANG_YAW_P    10
ATC_INPUT_TC     0.04
ATC_RATE_WPY_MAX 240
ATC_THR_MIX_MAN  4

# Rate loops.
ATC_RAT_PIT_P    0.04
ATC_RAT_PIT_I    0.04
ATC_RAT_PIT_D    0.0012
ATC_RAT_PIT_FLTD 60
ATC_RAT_PIT_FLTE 40
ATC_RAT_PIT_FLTT 60
ATC_RAT_PIT_SMAX 50
ATC_RAT_RLL_P    0.048
ATC_RAT_RLL_I    0.048
ATC_RAT_RLL_D    0.0008
ATC_RAT_RLL_FLTD 60
ATC_RAT_RLL_FLTT 60
ATC_RAT_RLL_SMAX 50
ATC_RAT_YAW_P    0.5
ATC_RAT_YAW_I    0.05
ATC_RAT_YAW_D    0.01
ATC_RAT_YAW_FLTD 60
ATC_RAT_YAW_FLTE 2
ATC_RAT_YAW_FLTT 60
ATC_RAT_YAW_SMAX 50

# Altitude and position loops for a low hover throttle.
PSC_D_ACC_FLTD   40
PSC_D_ACC_FLTT   40
PSC_D_ACC_P      0.02
PSC_D_VEL_P      3
PSC_NE_JERK      10

# Accelerations a 5 inch can do: pilot LOITER braking, and the navigation FOLLOW, RTL and
# avoidance use. Speeds stay in swarm.parm.
LOIT_ACC_MAX_M   10
LOIT_BRK_ACC_M   5
LOIT_BRK_JRK_M   10
LOIT_BRK_DELAY   0.25
WP_ACC           11
WP_ACC_Z         3
WP_JERK          6

# Gyro and accel filtering, with a harmonic notch on the motors.
INS_ACCEL_FILTER 15
INS_FAST_SAMPLE  3
INS_GYRO_FILTER  120
INS_HNTC2_ENABLE 1
INS_HNTC2_ATT    60
INS_HNTC2_BW     10
INS_HNTC2_FREQ   90
INS_HNTC2_HMNCS  15
INS_HNTC2_MODE   3
INS_HNTC2_OPTS   22
INS_HNTC2_REF    1

# A digital video transmitter (HDZero, Walksnail, DJI) on SERIAL5 draws ArduPilot's OSD from
# MSP DisplayPort, in SD 30x16 text (OSD1_TXT_RES 0), ArduPilot's symbols (MSP_OPTIONS 0).
# `swarm sim` sends SERIAL5 to the 3D viewer's camera feed (swarm.osd). Wire and set the real
# drone's own port.
OSD_TYPE         5
SERIAL5_PROTOCOL 42
OSD1_TXT_RES     0

# SITL's copter.parm puts "save waypoint" on channel 7; a real drone has nothing there.
RC7_OPTION       0
