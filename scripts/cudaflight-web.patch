+#define USE_OSD_SD
+#define USE_OSD_HD
+#define USE_CMS
+#define USE_MSP_DISPLAYPORT
+#define USE_OSD_OVER_MSP_DISPLAYPORT
+#undef ENABLE_FB_OSD
+#define ENABLE_FB_OSD 0
