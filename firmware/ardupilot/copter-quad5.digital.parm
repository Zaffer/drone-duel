# The 5" quad's OSD for digital video (drone_duels.firmware.ardupilot: loaded after
# copter-quad5.parm when the video system is digital, and set in flight on a switch to it).
# The same elements as the analog screen, laid out on HD's 50 x 18 as for a DJI, HDZero or
# Walksnail goggle: the corners' in the corners, the middle's in the middle.
OSD1_RSSI_X      1
OSD1_RSSI_Y      1
OSD1_SATS_X      1
OSD1_SATS_Y      3
OSD1_HOME_X      24
OSD1_HOME_Y      1
OSD1_HEADING_X   23
OSD1_HEADING_Y   2
OSD1_COMPASS_X   25
OSD1_COMPASS_Y   3
OSD1_BAT_VOLT_X  44
OSD1_BAT_VOLT_Y  1
OSD1_CURRENT_X   45
OSD1_CURRENT_Y   2
OSD1_BATUSED_X   43
OSD1_BATUSED_Y   3
OSD1_MESSAGE_X   12
OSD1_MESSAGE_Y   7
OSD1_FLTMODE_X   2
OSD1_FLTMODE_Y   9
OSD1_HORIZON_X   24
OSD1_HORIZON_Y   9
OSD1_ALTITUDE_X  43
OSD1_ALTITUDE_Y  9
OSD1_VSPEED_X    44
OSD1_VSPEED_Y    10
OSD1_THROTTLE_X  44
OSD1_THROTTLE_Y  12
OSD1_GPSLAT_X    19
OSD1_GPSLAT_Y    15
OSD1_GSPEED_X    2
OSD1_GSPEED_Y    16
OSD1_GPSLONG_X   19
OSD1_GPSLONG_Y   16
