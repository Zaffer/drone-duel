# The 5" quad's OSD for analog video (drone_duels.firmware.ardupilot: loaded after
# copter-quad5.parm when the video system is analog, and set in flight on a switch to it).
# ArduPilot's own screen 1, 30 x 16, with the ground speed and the position lifted into the 13
# rows NTSC shows.
OSD1_RSSI_X      1
OSD1_RSSI_Y      1
OSD1_SATS_X      1
OSD1_SATS_Y      3
OSD1_HOME_X      14
OSD1_HOME_Y      1
OSD1_HEADING_X   13
OSD1_HEADING_Y   2
OSD1_COMPASS_X   15
OSD1_COMPASS_Y   3
OSD1_BAT_VOLT_X  24
OSD1_BAT_VOLT_Y  1
OSD1_CURRENT_X   25
OSD1_CURRENT_Y   2
OSD1_BATUSED_X   23
OSD1_BATUSED_Y   3
OSD1_MESSAGE_X   2
OSD1_MESSAGE_Y   6
OSD1_FLTMODE_X   2
OSD1_FLTMODE_Y   8
OSD1_HORIZON_X   14
OSD1_HORIZON_Y   8
OSD1_ALTITUDE_X  23
OSD1_ALTITUDE_Y  8
OSD1_VSPEED_X    24
OSD1_VSPEED_Y    9
OSD1_THROTTLE_X  24
OSD1_THROTTLE_Y  11
OSD1_GPSLAT_X    9
OSD1_GPSLAT_Y    11
OSD1_GSPEED_X    2
OSD1_GSPEED_Y    12
OSD1_GPSLONG_X   9
OSD1_GPSLONG_Y   12
