# The TBS Chupito's INAV 9.1 settings, typed into INAV SITL's CLI and saved
# (drone_duels.firmware.inav.configure) whenever they change. Lines starting # are comments.

# The simulator's sensors and receiver. SITL's defaults leave the GPS off.
feature GPS
set gps_provider = FAKE
set acc_hardware = FAKE
set baro_hardware = FAKE
set mag_hardware = FAKE
set pitot_hardware = VIRTUAL
set receiver_type = SIM (SITL)
# INAV 9.1 SITL reads our pack only from its own X-Plane plugin (the inav_xitl datarefs, once
# inav_xitl/plugin/xitlDrefVersion answers), which the simulator does not play. Without it the
# only battery is SITL's fake one, a fixed 16.8 V: a full 4S, not TBS's 6S, which would read
# 2.8 V a cell, critical. With no battery at all INAV 9.1 dies on disarming: its OSD's stats
# divide the lowest voltage by a cell count of 0 (SIGFPE, drawStat_BatteryVoltage).
set vbat_meter_type = FAKE
set bat_cells = 4

# TBS's Chupito INAV CLI suggestions (INAV 8.0.1), less what is the real board's.
feature FW_LAUNCH
set platform_type = AIRPLANE
mmix reset
mmix 0 1.000 0.000 0.000 0.000
smix reset
smix 0 1 0 -80 0 -1
smix 1 1 1 -60 0 -1
smix 2 2 0 -80 0 -1
smix 3 2 1 60 0 -1
set failsafe_procedure = RTH
set small_angle = 180
set airmode_type = STICK_CENTER_ONCE
set nav_wp_radius = 1000
set nav_wp_max_safe_distance = 500
set nav_fw_soaring_motor_stop = ON
set nav_rth_allow_landing = FS_ONLY
set nav_rth_altitude = 12000
set nav_rth_home_altitude = 6500
set nav_fw_bank_angle = 45
set nav_fw_manual_climb_rate = 500
set nav_fw_climb_angle = 45
set nav_fw_dive_angle = 30
set nav_fw_loiter_radius = 15000
set nav_fw_control_smoothness = 2
set nav_fw_launch_max_angle = 180
set nav_fw_launch_motor_delay = 0
set nav_fw_launch_spinup_time = 250
set nav_fw_launch_max_altitude = 15000
set nav_fw_launch_climb_angle = 45
set fw_p_pitch = 15
set fw_i_pitch = 5
set fw_d_pitch = 5
set fw_ff_pitch = 70
set fw_p_roll = 15
set fw_i_roll = 3
set fw_d_roll = 7
set fw_p_yaw = 20
set fw_i_yaw = 0
set fw_ff_yaw = 100
set max_angle_inclination_rll = 550
set dterm_lpf_hz = 10
set fw_turn_assist_pitch_gain = 0.300
set nav_fw_pos_z_p = 35
set nav_fw_pos_xy_p = 70
set rc_expo = 30
set rc_yaw_expo = 30
set roll_rate = 18
set pitch_rate = 12
set yaw_rate = 4
set manual_rc_expo = 60
set throttle_idle = 5.000
set nav_fw_cruise_thr = 1350
set nav_fw_min_thr = 1100
set nav_fw_launch_thr = 2000

# Modes: CH5 high arms; CH6 low ANGLE, middle ACRO (no mode), high MANUAL; CH7 high RTH.
aux 0 0 0 1700 2100
aux 1 1 1 900 1300
aux 2 12 1 1700 2100
aux 3 10 2 1700 2100
