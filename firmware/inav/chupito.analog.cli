# The Chupito's OSD for analog video (drone_duels.firmware.inav: added to chupito.cli when the
# video system is analog), as an analog OSD chip would draw it: MSP DisplayPort on UART3 in
# Betaflight-compatible SD (BF43COMPAT: 30 x 16, Betaflight's glyphs), cut to the 13 rows NTSC
# shows. TBS's HD layout, re-fitted: the same elements, on the same sides, everything in
# columns 0-29 and rows 0-12 (the flight mode and the messages on the last two shown).
serial 2 33554432 115200 115200 0 115200
set osd_video_system = BF43COMPAT
osd_layout 0 0 23 0 H
osd_layout 0 1 12 0 H
osd_layout 0 7 1 11 V
osd_layout 0 8 12 3 H
osd_layout 0 9 1 4 H
osd_layout 0 11 1 2 V
osd_layout 0 12 8 1 V
osd_layout 0 13 17 1 V
osd_layout 0 14 24 3 V
osd_layout 0 15 23 2 V
osd_layout 0 22 15 1 V
osd_layout 0 23 23 1 V
osd_layout 0 26 15 2 V
osd_layout 0 28 23 12 H
osd_layout 0 30 1 12 V
osd_layout 0 32 1 1 V
osd_layout 0 33 1 5 H
osd_layout 0 35 8 2 V
osd_layout 0 40 1 6 H
osd_layout 0 87 8 11 V
osd_layout 0 107 1 3 V
osd_layout 0 109 24 11 V
osd_layout 0 110 24 10 V
osd_layout 0 111 24 8 V
osd_layout 0 112 23 9 V
osd_layout 0 125 1 7 H
osd_layout 0 142 12 4 H
