{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol",
  "type": "object",
  "$defs": {
    "SessionMsg": {
      "additionalProperties": false,
      "description": "Start a vehicle at a location, switch vehicle (back at the start), reset, destroy (a\ncrash: the physics stops dead), throw (a hand-launched wing), or stop.",
      "properties": {
        "ch": {
          "const": "session",
          "default": "session",
          "type": "string"
        },
        "action": {
          "enum": [
            "start",
            "switch",
            "reset",
            "destroy",
            "throw",
            "stop"
          ],
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vehicle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pad": {
          "default": 0,
          "description": "the start pad: 0 player 1, 1 player 2",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ch",
        "action",
        "location",
        "vehicle",
        "pad"
      ],
      "title": "SessionMsg",
      "type": "object"
    },
    "RcMsg": {
      "additionalProperties": false,
      "description": "The radio's channels, from channel 1, \u00b5s (1000-2000).",
      "properties": {
        "ch": {
          "const": "rc",
          "default": "rc",
          "type": "string"
        },
        "seq": {
          "type": "integer"
        },
        "us": {
          "items": {
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "ch",
        "seq",
        "us"
      ],
      "title": "RcMsg",
      "type": "object"
    },
    "GroundMsg": {
      "additionalProperties": false,
      "description": "The ground's height above sea level under the vehicle, from the map's 3D tiles.",
      "properties": {
        "ch": {
          "const": "ground",
          "default": "ground",
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "alt": {
          "type": "number"
        }
      },
      "required": [
        "ch",
        "lat",
        "lon",
        "alt"
      ],
      "title": "GroundMsg",
      "type": "object"
    },
    "Wind": {
      "additionalProperties": false,
      "properties": {
        "speed_ms": {
          "description": "mean wind at 6 m, m/s",
          "maximum": 30,
          "minimum": 0,
          "type": "number"
        },
        "from_deg": {
          "description": "where it blows from, degrees true",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "type": "number"
        },
        "turbulence": {
          "description": "MIL-F-8785C's turbulence for this wind (\u03c3_w 0.1 \u00d7 the wind at 6 m) times this: 0 smooth air, 1 the standard's, 2 and 3 as rough as its moderate and severe",
          "maximum": 3,
          "minimum": 0,
          "type": "number"
        },
        "eddy_scale": {
          "description": "the turbulence's scale lengths times this: larger is slower, rolling air; 1 is MIL-F-8785C's",
          "maximum": 4,
          "minimum": 0.25,
          "type": "number"
        },
        "gust_factor": {
          "description": "the strongest gust over the mean wind, as a weather report gives it; 1: no gusts on top of the turbulence",
          "maximum": 2.5,
          "minimum": 1,
          "type": "number"
        },
        "gust_every_s": {
          "description": "mean time between gusts, s",
          "maximum": 120,
          "minimum": 2,
          "type": "number"
        }
      },
      "required": [
        "speed_ms",
        "from_deg",
        "turbulence",
        "eddy_scale",
        "gust_factor",
        "gust_every_s"
      ],
      "title": "Wind",
      "type": "object"
    },
    "WindMsg": {
      "additionalProperties": false,
      "description": "The wind now (the Wind options tab); `gust_now` starts a gust at once (G).",
      "properties": {
        "ch": {
          "const": "wind",
          "default": "wind",
          "type": "string"
        },
        "wind": {
          "$ref": "#/$defs/Wind"
        },
        "gust_now": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "ch",
        "wind",
        "gust_now"
      ],
      "title": "WindMsg",
      "type": "object"
    },
    "VideoMsg": {
      "additionalProperties": false,
      "properties": {
        "ch": {
          "const": "video",
          "default": "video",
          "type": "string"
        },
        "system": {
          "enum": [
            "analog",
            "digital"
          ],
          "type": "string"
        }
      },
      "required": [
        "ch",
        "system"
      ],
      "title": "VideoMsg",
      "type": "object"
    },
    "DynamicsMsg": {
      "additionalProperties": false,
      "description": "Stream the flight model's internals (the dynamics overlay) or stop.",
      "properties": {
        "ch": {
          "const": "dynamics",
          "default": "dynamics",
          "type": "string"
        },
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "ch",
        "on"
      ],
      "title": "DynamicsMsg",
      "type": "object"
    },
    "RadioSourceMsg": {
      "additionalProperties": false,
      "description": "Read the radio in the server (Linux evdev) and stream its axes here (RadioMsg), for when\nChrome's Gamepad API cannot see all of it; or stop.",
      "properties": {
        "ch": {
          "const": "radio_source",
          "default": "radio_source",
          "type": "string"
        },
        "on": {
          "type": "boolean"
        }
      },
      "required": [
        "ch",
        "on"
      ],
      "title": "RadioSourceMsg",
      "type": "object"
    },
    "StatusMsg": {
      "additionalProperties": false,
      "properties": {
        "ch": {
          "const": "status",
          "default": "status",
          "type": "string"
        },
        "state": {
          "enum": [
            "idle",
            "starting",
            "ready",
            "failed",
            "destroyed"
          ],
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "vehicle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pad": {
          "default": 0,
          "type": "integer"
        },
        "step": {
          "default": "",
          "description": "what starting is doing now, or why it failed",
          "type": "string"
        },
        "video": {
          "default": "analog",
          "enum": [
            "analog",
            "digital"
          ],
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "additionalItems": false
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the pad: lat, lon, ground m above sea level"
        },
        "heading_deg": {
          "default": 0.0,
          "type": "number"
        }
      },
      "required": [
        "ch",
        "state",
        "location",
        "vehicle",
        "pad",
        "step",
        "video",
        "origin",
        "heading_deg"
      ],
      "title": "StatusMsg",
      "type": "object"
    },
    "TelemetryMsg": {
      "additionalProperties": false,
      "description": "What a ground station sees, from MAVLink (ArduPilot) or MSP (INAV): the map and the dials\nread this, never the physics (DESIGN.md \u00a72.2).",
      "properties": {
        "ch": {
          "const": "telemetry",
          "default": "telemetry",
          "type": "string"
        },
        "armed": {
          "type": "boolean"
        },
        "mode": {
          "type": "string"
        },
        "lat": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lon": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alt_amsl": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "alt_rel": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "above home, m"
        },
        "roll_deg": {
          "default": 0.0,
          "type": "number"
        },
        "pitch_deg": {
          "default": 0.0,
          "type": "number"
        },
        "yaw_deg": {
          "default": 0.0,
          "type": "number"
        },
        "groundspeed": {
          "default": 0.0,
          "type": "number"
        },
        "airspeed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "climb": {
          "default": 0.0,
          "type": "number"
        },
        "throttle_pct": {
          "default": 0.0,
          "type": "number"
        },
        "battery_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "battery_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gps_sats": {
          "default": 0,
          "type": "integer"
        },
        "blockers": {
          "description": "what stops it arming",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ch",
        "armed",
        "mode",
        "lat",
        "lon",
        "alt_amsl",
        "alt_rel",
        "roll_deg",
        "pitch_deg",
        "yaw_deg",
        "groundspeed",
        "airspeed",
        "climb",
        "throttle_pct",
        "battery_v",
        "battery_pct",
        "gps_sats",
        "blockers"
      ],
      "title": "TelemetryMsg",
      "type": "object"
    },
    "OsdMsg": {
      "additionalProperties": false,
      "description": "The firmware's own OSD screen, as MSP DisplayPort drew it: character codes row by row.",
      "properties": {
        "ch": {
          "const": "osd",
          "default": "osd",
          "type": "string"
        },
        "font": {
          "description": "the font's name, served at /osd/font/{font}.png",
          "type": "string"
        },
        "cols": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "codes": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "ch",
        "font",
        "cols",
        "rows",
        "codes"
      ],
      "title": "OsdMsg",
      "type": "object"
    },
    "PlanItem": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer"
        },
        "command": {
          "type": "integer"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "alt": {
          "type": "number"
        },
        "frame": {
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "command",
        "lat",
        "lon",
        "alt",
        "frame"
      ],
      "title": "PlanItem",
      "type": "object"
    },
    "PlanMsg": {
      "additionalProperties": false,
      "description": "The vehicle's uploaded mission, fence and rally points (ArduPilot).",
      "properties": {
        "ch": {
          "const": "plan",
          "default": "plan",
          "type": "string"
        },
        "mission": {
          "items": {
            "$ref": "#/$defs/PlanItem"
          },
          "type": "array"
        },
        "fence": {
          "items": {
            "$ref": "#/$defs/PlanItem"
          },
          "type": "array"
        },
        "rally": {
          "items": {
            "$ref": "#/$defs/PlanItem"
          },
          "type": "array"
        }
      },
      "required": [
        "ch",
        "mission",
        "fence",
        "rally"
      ],
      "title": "PlanMsg",
      "type": "object"
    },
    "DynamicsData": {
      "additionalProperties": false,
      "properties": {
        "ch": {
          "const": "dynamics",
          "default": "dynamics",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "ch",
        "data"
      ],
      "title": "DynamicsData",
      "type": "object"
    },
    "LogMsg": {
      "additionalProperties": false,
      "description": "A line from the firmware (STATUSTEXT) or the session.",
      "properties": {
        "ch": {
          "const": "log",
          "default": "log",
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warn",
            "error"
          ],
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "ch",
        "level",
        "source",
        "text"
      ],
      "title": "LogMsg",
      "type": "object"
    },
    "RadioMsg": {
      "additionalProperties": false,
      "description": "The radio as the server reads it: every axis, -1..1, nothing reversed; name None with no\nradio. At the radio's rate while a page asks (RadioSourceMsg).",
      "properties": {
        "ch": {
          "const": "radio",
          "default": "radio",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "axes": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "ch",
        "name",
        "axes"
      ],
      "title": "RadioMsg",
      "type": "object"
    },
    "PhysicsMsg": {
      "additionalProperties": false,
      "description": "What the physics says the vehicle is doing, on each change: \"ground\", \"hand\", \"flying\",\n\"crashed\"; and whether its firmware is stepping it.",
      "properties": {
        "ch": {
          "const": "physics",
          "default": "physics",
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        }
      },
      "required": [
        "ch",
        "phase",
        "connected"
      ],
      "title": "PhysicsMsg",
      "type": "object"
    },
    "AuxSpec": {
      "additionalProperties": false,
      "description": "What the firmware does on each AUX channel (channel numbers 5-16).",
      "properties": {
        "arm": {
          "maximum": 16,
          "minimum": 5,
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "maximum": 16,
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modes": {
          "description": "the mode switch's positions, low to high",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "launch": {
          "anyOf": [
            {
              "maximum": 16,
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "arm",
        "mode",
        "modes",
        "launch"
      ],
      "title": "AuxSpec",
      "type": "object"
    },
    "AxisMap": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "description": "Gamepad API axis index",
          "maximum": 15,
          "minimum": 0,
          "type": "integer"
        },
        "reverse": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "axis",
        "reverse"
      ],
      "title": "AxisMap",
      "type": "object"
    },
    "ButtonMap": {
      "additionalProperties": false,
      "properties": {
        "button": {
          "maximum": 31,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "button"
      ],
      "title": "ButtonMap",
      "type": "object"
    },
    "CameraSpec": {
      "additionalProperties": false,
      "properties": {
        "tilt_deg": {
          "description": "up from the nose",
          "maximum": 80,
          "minimum": -30,
          "type": "number"
        },
        "hfov_deg": {
          "description": "the FPV camera's horizontal view",
          "exclusiveMaximum": 170,
          "exclusiveMinimum": 30,
          "type": "number"
        },
        "offset_m": {
          "description": "forward, right, down of the CG",
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
        }
      },
      "required": [
        "tilt_deg",
        "hfov_deg",
        "offset_m"
      ],
      "title": "CameraSpec",
      "type": "object"
    },
    "Controller": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "match": {
          "description": "substrings of the Gamepad API id ('Vendor: 1209 Product: 4f54') that pick this profile",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "channels": {
          "description": "channel 1, 2, 3 ... in AETR order",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/AxisMap"
              },
              {
                "$ref": "#/$defs/ButtonMap"
              }
            ]
          },
          "maxItems": 16,
          "minItems": 4,
          "type": "array"
        },
        "notes": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "match",
        "channels",
        "notes"
      ],
      "title": "Controller",
      "type": "object"
    },
    "Course": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "laps": {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "alt_ref": {
          "enum": [
            "agl",
            "amsl"
          ],
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/GateFrame"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/Gate"
          },
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "location",
        "laps",
        "alt_ref",
        "gate",
        "gates"
      ],
      "title": "Course",
      "type": "object"
    },
    "FirmwareSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "ardupilot-copter",
            "inav",
            "none"
          ],
          "type": "string"
        },
        "params": {
          "description": "parameter / CLI files, relative to firmware/",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "params"
      ],
      "title": "FirmwareSpec",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "description": "[latitude, longitude], degrees",
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
        },
        "alt_m": {
          "description": "the gate's centre, m above the ground or sea (alt_ref)",
          "type": "number"
        },
        "ypr_deg": {
          "description": "yaw true, pitch, roll",
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
        }
      },
      "required": [
        "at",
        "alt_m",
        "ypr_deg"
      ],
      "title": "Gate",
      "type": "object"
    },
    "GateFrame": {
      "additionalProperties": false,
      "description": "The course's gate: a square frame round the inside that is flown through.",
      "properties": {
        "inside_m": {
          "description": "width, height of the way through",
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
        },
        "outside_m": {
          "description": "width, height of the whole frame",
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "additionalItems": false
        },
        "depth_m": {
          "description": "the frame's thickness along the way through",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "inside_m",
        "outside_m",
        "depth_m"
      ],
      "title": "GateFrame",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
